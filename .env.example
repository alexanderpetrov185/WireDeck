# ===========================================
# WireDeck Environment Configuration
# Скопируйте этот файл в .env и заполните значения
# cp .env.example .env
# ===========================================

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=wiredeck

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Application Configuration
PORT=3000
NODE_ENV=development

# Frontend Configuration
# NEXT_PUBLIC_API_URL=http://localhost:3000  # НЕ используется для BFF (токен не в NEXT_PUBLIC_*)
# Server-side BFF: URL backend из контейнера frontend (Docker networking).
BACKEND_API_URL=http://backend:3000
# Имя модератора, передаваемое в POST /moderation/approve|reject (server-side).
ADMIN_MODERATOR=frontend-admin

# ===========================================
# Monitoring & Logging Configuration
# ===========================================

# Sentry (Error Tracking)
# Backend Sentry DSN (получите на https://sentry.io)
SENTRY_DSN=
# Frontend Sentry DSN (публичный, для браузера)
NEXT_PUBLIC_SENTRY_DSN=
# Sentry организация (для загрузки sourcemaps)
SENTRY_ORG=wiredeck
# Sentry проект
SENTRY_PROJECT=backend
# Sentry auth token (для загрузки sourcemaps)
SENTRY_AUTH_TOKEN=

# Логирование
# Уровень логирования: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# ===========================================
# Prometheus & Grafana Configuration
# ===========================================

# Prometheus порт (для сбора метрик)
PROMETHEUS_PORT=9090

# Grafana порт (веб-интерфейс)
GRAFANA_PORT=3002
# Grafana учетные данные (по умолчанию)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# Loki порт (агрегатор логов)
LOKI_PORT=3100

# ===========================================
# RSS Collector Configuration
# ===========================================

# Список URL RSS-фидов через запятую
RSS_FEEDS=https://www.reutersagency.com/feed/?best-topics=business,https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=10000664

# ===========================================
# Ingestion endpoint protection
# ===========================================

# Токен для POST /ingestion/rss (заголовок x-ingestion-token)
# Если пустой — endpoint закрыт
INGESTION_TOKEN=change-me-in-production

# ===========================================
# AI Processing Configuration
# ===========================================

# URL OpenAI-compatible endpoint
AI_PROVIDER_URL=https://api.openai.com/v1/chat/completions
# API key for AI provider
AI_API_KEY=your_ai_api_key_here
# AI model to use
AI_MODEL=gpt-4o-mini

# ===========================================
# Translation Configuration
# ===========================================

# URL OpenAI-compatible endpoint for translation
TRANSLATION_PROVIDER_URL=https://api.openai.com/v1/chat/completions
# API key for translation provider
TRANSLATION_API_KEY=your_translation_api_key_here
# Translation model to use
TRANSLATION_MODEL=gpt-4o-mini
# Target language for translation (en, ru)
TRANSLATION_TARGET_LANGUAGE=en

# ===========================================
# Telegram Publishing Configuration
# ===========================================

# Telegram bot API token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Target channel ID (e.g. -100...) or @username
TELEGRAM_CHANNEL_ID=your_telegram_channel_id_here

# ===========================================
# Pipeline Scheduler (Sprint 9) Configuration
# ===========================================

# Включить периодический запуск полного pipeline (true/false).
# По умолчанию false — scheduler НЕ создаёт jobs автоматически.
SCHEDULER_ENABLED=false
# Интервал между запусками pipeline в миллисекундах (дефолт 600000 = 10 минут).
# Минимальное допустимое значение: 5000.
PIPELINE_INTERVAL_MS=600000
# Максимум новостей, обрабатываемых на каждом шаге pipeline за один прогон.
PIPELINE_BATCH_LIMIT=50

# ===========================================
# Reliability & Observability (Sprint 11)
# ===========================================

# Интервал сбора реальных счётчиков BullMQ (getJobCounts) в метрики, мс.
PIPELINE_STATS_INTERVAL_MS=15000
# Интервал проверки застрявших публикаций (stuck publishing detection), мс.
PUBLISHING_STUCK_SWEEP_INTERVAL_MS=600000
# Возраст записи PUBLISHED без telegram_message_id, считающийся застрявшей, мс.
PUBLISHING_STUCK_THRESHOLD_MS=3600000
