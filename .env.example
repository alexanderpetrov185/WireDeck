# ===========================================
# WireDeck Environment Configuration
# Скопируйте этот файл в .env и заполните значения
# cp .env.example .env
# ===========================================

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
# Обязательно задайте сильный пароль перед запуском (compose требует непустой).
DB_PASSWORD=
DB_NAME=wiredeck

# Redis Configuration (REDIS_URL is NOT read by code; BullMQ uses REDIS_HOST/PORT)
REDIS_HOST=localhost
REDIS_PORT=6379

# Application Configuration
PORT=3000
NODE_ENV=development

# Frontend Configuration
# NEXT_PUBLIC_API_URL=http://localhost:3000  # НЕ используется для BFF (токен не в NEXT_PUBLIC_*)
# Server-side BFF: URL backend из контейнера frontend (Docker networking).
BACKEND_API_URL=http://backend:3000
# Имя модератора, передаваемое в POST /moderation/approve|reject (server-side).
ADMIN_MODERATOR=frontend-admin

# ===========================================
# Admin BFF Authentication
# ===========================================

# Пароль для доступа к /api/admin/* (страница /login).
# Обязателен: если пустой — весь админ BFF закрыт (401).
ADMIN_PASSWORD=

# ===========================================
# Monitoring & Logging Configuration
# ===========================================

# Sentry (Error Tracking)
# Backend Sentry DSN (получите на https://sentry.io)
SENTRY_DSN=
# Frontend Sentry DSN (публичный, для браузера)
NEXT_PUBLIC_SENTRY_DSN=
# Sentry организация (для загрузки sourcemaps)
SENTRY_ORG=wiredeck
# Sentry проект
SENTRY_PROJECT=backend
# Sentry auth token (для загрузки sourcemaps)
SENTRY_AUTH_TOKEN=

# Логирование
# Уровень логирования: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# ===========================================
# Prometheus & Grafana Configuration
# ===========================================

# Prometheus порт (для сбора метрик)
PROMETHEUS_PORT=9090

# Grafana порт (веб-интерфейс)
GRAFANA_PORT=3002
# Grafana учетные данные (по умолчанию)
GRAFANA_ADMIN_USER=admin
# Задайте сильный пароль; не используйте дефолтный admin123.
GRAFANA_ADMIN_PASSWORD=

# Loki порт (агрегатор логов)
LOKI_PORT=3100

# ===========================================
# RSS Collector Configuration
# ===========================================

# Список URL RSS-фидов через запятую (http/https). Пустые/невалидные/дубликаты
# отбрасываются коллектором с warn-логом и не прерывают сбор остальных.
# Добавляйте свои фиды: `https://example.com/feed.xml, https://other.com/rss`
# ВАЖНО: если URL содержит `&` — оборачивайте значение в кавычки в shell/compose.
# Дедупликация новостей между фидами выполняется на уровне ingestion (по hash).

# Pragmatic default pack (business/markets, EN):
RSS_FEEDS=https://www.reutersagency.com/feed/?best-topics=business,https://www.cnbc.com/id/100003114/device/rss/rss.html,https://www.cnbc.com/id/20910258/device/rss/rss.html,https://feeds.content.dowjones.io/public/rss/mw_topstories,https://finance.yahoo.com/news/rssindex,https://www.investing.com/rss/news_25.rss,https://www.coindesk.com/arc/outboundfeeds/rss/,https://feeds.bbci.co.uk/news/business/rss.xml

# ===========================================
# Ingestion endpoint protection
# ===========================================

# Токен для POST /ingestion/rss (заголовок x-ingestion-token)
# Если пустой — endpoint закрыт
INGESTION_TOKEN=

# ===========================================
# AI Processing Configuration
# ===========================================

# URL OpenAI-compatible endpoint
AI_PROVIDER_URL=https://api.openai.com/v1/chat/completions
# API key for AI provider
AI_API_KEY=your_ai_api_key_here
# AI model to use
AI_MODEL=gpt-4o-mini

# ===========================================
# Translation Configuration
# ===========================================

# URL OpenAI-compatible endpoint for translation
TRANSLATION_PROVIDER_URL=https://api.openai.com/v1/chat/completions
# API key for translation provider
TRANSLATION_API_KEY=your_translation_api_key_here
# Translation model to use
TRANSLATION_MODEL=gpt-4o-mini
# Target language for translation (en, ru)
TRANSLATION_TARGET_LANGUAGE=en

# ===========================================
# Telegram Publishing Configuration
# ===========================================

# Telegram bot API token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Target channel ID (e.g. -100...) or @username
TELEGRAM_CHANNEL_ID=your_telegram_channel_id_here

# ===========================================
# Pipeline Scheduler & Daily Operation
# ===========================================

# Секция по умолчанию — safe base (соответствует коду).
# Ниже, после этой секции, даётся закомментированный блок
# "daily operation" для включения автоматических запусков.

# Включить периодический запуск полного pipeline (true/false).
# По умолчанию false — scheduler НЕ создаёт jobs автоматически
# (pipeline запускается только вручную: кнопка "Run Pipeline" в админке
# или curl /pipeline/trigger).
SCHEDULER_ENABLED=false
# Интервал между запусками pipeline в миллисекундах (дефолт 600000 = 10 минут).
# Минимальное допустимое значение: 5000.
# ДЕДУП: каждый тик шлёт job с фиксированным jobId — если предыдущий ещё
# выполняется (active/waiting/delayed), тик пропускается (нет пересечения runs).
PIPELINE_INTERVAL_MS=600000
# Максимум новостей, обрабатываемых на каждом шаге pipeline за один прогон.
# Sprint 12: снижено до 10 — free-tier Groq отдаёт 429 при больших батчах.
PIPELINE_BATCH_LIMIT=10

# --- Recommended "daily operation" preset (раскомментируйте при желании) ---
# Описывает режим полу-автономной ежедневной работы:
# - scheduler включён на 1 час;
# - moderation = hybrid: важные новости (importance >= 0.6) публикуются сами,
#   остальные ждут решения оператора в админке (канал не залит спамом).
# SCHEDULER_ENABLED=true
# PIPELINE_INTERVAL_MS=3600000
# PIPELINE_BATCH_LIMIT=10
# MODERATION_MODE=hybrid
# MODERATION_AUTO_IMPORTANCE_MIN=0.6

# ===========================================
# AI/Translation Rate Limits (Sprint 12)
# ===========================================

# Повторные попытки при HTTP 429 (rate limit) у AI/translation провайдеров.
AI_RATE_LIMIT_RETRIES=2
# Базовая задержка exponential backoff в мс (удваивается с каждой попыткой).
AI_RATE_LIMIT_BASE_DELAY_MS=2000

# ===========================================
# Moderation Policy (Sprint 14)
# ===========================================

# auto   — pipeline одобряет все QUEUED автоматически (как раньше);
# manual — pipeline ничего не одобряет, всё решает человек в админке /moderation;
# hybrid — auto только для новостей с importance >= MODERATION_AUTO_IMPORTANCE_MIN,
#          остальные ждут ручного решения.
MODERATION_MODE=auto
# Порог importance для hybrid-режима (0..1).
MODERATION_AUTO_IMPORTANCE_MIN=0.6

# ===========================================
# Reliability & Observability (Sprint 11)
# ===========================================

# Интервал сбора реальных счётчиков BullMQ (getJobCounts) в метрики, мс.
PIPELINE_STATS_INTERVAL_MS=15000
# Интервал проверки застрявших публикаций (stuck publishing detection), мс.
PUBLISHING_STUCK_SWEEP_INTERVAL_MS=600000
# Возраст записи PUBLISHED без telegram_message_id, считающийся застрявшей, мс.
PUBLISHING_STUCK_THRESHOLD_MS=3600000
