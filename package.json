{
  "name": "wiredeck",
  "version": "1.0.0",
  "description": "A monorepo for financial and market news aggregation",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run start:dev --workspace=@wiredeck/backend",
    "dev:frontend": "npm run dev --workspace=@wiredeck/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:backend": "npm run build --workspace=@wiredeck/backend",
    "build:frontend": "npm run build --workspace=@wiredeck/frontend",
    "start": "npm run start --workspaces --if-present",
    "start:backend": "npm run start --workspace=@wiredeck/backend",
    "start:frontend": "npm run start --workspace=@wiredeck/frontend",
    "docker:up": "docker compose -f compose.yaml up -d",
    "docker:down": "docker compose -f compose.yaml down",
    "docker:build": "docker compose -f compose.yaml build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "keywords": [
    "monorepo",
    "nestjs",
    "nextjs",
    "financial",
    "markets",
    "news",
    "aggregator"
  ],
  "author": "",
  "license": "MIT"
}